// gonona.nil — Onuron OS গণক ও ভেক্টর অপ্টিমাইজার
let name = "অনুরণ গণক"
let base = 15
let multiplier = 4
let total = base * multiplier
print("প্রোগ্রাম নাম: ", name)
print("মোট ফলাফল: ", total)
for i in 1..5 {
    let square = i * i
    print("সংখ্যা: ", i, " -> বর্গ: ", square)
}
send("system_monitor", "গণনা সমাপ্ত")
